package Top where

-- The array (Section 6.3): numTiles identical tiles on a mesh, each link a
-- pair of rules that move one packet per cycle in each direction. mkTop
-- is also the simulation harness: it reads a seed and a cycle bound from
-- ctl.hex, halts every tile on the cycle after any tile faults, and stops
-- when the whole array is quiescent.

import Vector
import RegFile
import Config
import RhoTypes
import Tile

linkRule :: Tile -> Integer -> Tile -> Integer -> Rules
linkRule a da b db =
  rules
    "link": when (select a.links da).outValid && (select b.links db).inReady
     ==> action
            (select b.links db).inPut (select a.links da).outFirst
            (select a.links da).outDeq

{-# verilog mkTop #-}
mkTop :: Module Empty
mkTop =
  module
    let ids :: Vector NT Integer
        ids = genVector
    tiles :: Vector NT Tile <- mapM (\ i -> mkTile (fromInteger i)) ids
    ctlRom :: RegFile (Bit 1) (Bit 32) <- mkRegFileFullLoad "ctl.hex"
    cyc    :: Reg (Bit 32) <- mkReg 0
    halted :: Reg Bool <- mkReg False
    fin    :: Reg (Bit 2) <- mkReg 0

    let tileLinks :: Integer -> Rules
        tileLinks i =
          let x = mod i tilesW
              y = div i tilesW
              t = select tiles i
              east = if x < tilesW - 1
                       then (linkRule t 1 (select tiles (i + 1)) 3) <+> (linkRule (select tiles (i + 1)) 3 t 1)
                       else emptyRules
              south = if y < tilesH - 1
                        then (linkRule t 2 (select tiles (i + tilesW)) 0) <+> (linkRule (select tiles (i + tilesW)) 0 t 2)
                        else emptyRules
          in east <+> south
        allLinks :: Vector NT Rules
        allLinks = genWith tileLinks
    addRules (foldr (<+>) emptyRules allLinks)

    let anyFault :: Bool
        anyFault = foldr (\ t b -> b || t.fault /= 0) False tiles
        allIdle :: Bool
        allIdle = foldr (\ t b -> b && t.idle) True tiles
        ctls :: Vector NT Action
        ctls = map (\ t -> t.ctl (halted || fin /= 0) (ctlRom.sub 0) (fin == 1)) tiles

    rules
      "ctl": when True
       ==> action
              joinActions ctls
              cyc := cyc + 1
              if anyFault then halted := True else noAction
              if fin == 2
                then $finish
                else if fin == 1
                  then fin := 2
                  else if halted
                    then action { $display "X %0d" cyc; $finish }
                    else if allIdle
                      then action { $display "Q %0d" cyc; fin := 1 }
                      else if cyc >= ctlRom.sub 1
                        then action { $display "T %0d" cyc; $finish }
                        else noAction
