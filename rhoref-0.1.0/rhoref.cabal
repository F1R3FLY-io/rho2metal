cabal-version:      2.4
name:               rhoref
version:            0.1.0
synopsis:           Reference implementation of the rho calculus with Boolean arithmetic and its hardware machine model
description:        Executable semantics, a word-level model of the tuple-space machine, and the
                    step-refinement checker, conforming to the design specification (draft 0.2).
category:           Language
build-type:         Simple
extra-doc-files:    README.md
extra-source-files: examples/*.rho

common shared
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:    base >=4.14 && <5, containers >=0.6, mtl >=2.2, transformers >=0.5

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  Rho.Syntax, Rho.Core, Rho.Machine, Rho.Checker

executable rhoref
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    rhoref

test-suite rhoref-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Test.hs
  build-depends:    rhoref
